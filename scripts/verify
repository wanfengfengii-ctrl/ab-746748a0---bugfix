#!/bin/sh
# 一次性校验入口：服务健康后完成代码测试与含漏读/杂点的复原冒烟，
# 以退出码汇报结果（0 全部通过，非 0 存在失败）。
#
# 容器内模式（docker-compose verify 服务）：
#   BASE_URL 指向健康后的 API，直接运行 pytest 与冒烟。
# 宿主模式：
#   - 有 docker：构建应用镜像 -> 起服务 -> 等健康 -> 一次性容器内校验 -> 清理
#   - 无 docker：用 .venv 本地起 uvicorn -> 等健康 -> pytest + 冒烟 -> 清理
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT_DIR"

API_PORT="${API_PORT:-8080}"

run_tests_and_smoke() {
  echo "==> [1/2] 代码测试 (pytest)"
  python -m pytest -q tests
  echo "==> [2/2] 复原冒烟（漏读 + 杂点 + 无解 + 输入矛盾）"
  BASE_URL="$1" python scripts/smoke.py
}

wait_health() {
  url="$1"
  echo "等待服务健康: $url/health"
  i=0
  while [ "$i" -lt 60 ]; do
    if python - "$url" <<'PY'
import sys, urllib.request
try:
    with urllib.request.urlopen(sys.argv[1] + "/health", timeout=2) as r:
        sys.exit(0 if r.status == 200 else 1)
except Exception:
    sys.exit(1)
PY
    then
      echo "服务已健康"
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done
  echo "服务在 60s 内未通过健康检查" >&2
  return 1
}

if [ -n "${BASE_URL:-}" ]; then
  # 容器内模式：健康条件已由 compose depends_on 保证
  wait_health "$BASE_URL"
  run_tests_and_smoke "$BASE_URL"
  exit $?
fi

if command -v docker >/dev/null 2>&1; then
  echo "==> 宿主 Docker 模式 (API_PORT=$API_PORT)"
  echo "==> 构建应用镜像"
  API_PORT="$API_PORT" docker compose build
  # 起 api；健康后自动起一次性 verify；以 verify 退出码为准
  API_PORT="$API_PORT" docker compose up --no-log-prefix \
      --abort-on-container-exit --exit-code-from verify verify
  rc=$?
  API_PORT="$API_PORT" docker compose down --remove-orphans || true
  exit $rc
fi

echo "==> 宿主本地模式（未检测到 docker，使用 .venv）"
if [ ! -x .venv/bin/python ]; then
  python3 -m venv .venv
  .venv/bin/pip install --quiet -r requirements.txt
fi
PATH="$ROOT_DIR/.venv/bin:$PATH"
export PATH
BASE_URL="http://127.0.0.1:$API_PORT"
.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$API_PORT" \
    >/tmp/wafer-api.log 2>&1 &
api_pid=$!
cleanup() { kill "$api_pid" 2>/dev/null || true; }
trap cleanup EXIT INT TERM

wait_health "$BASE_URL"
run_tests_and_smoke "$BASE_URL"
